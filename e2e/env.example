# Copy to e2e/.env.local (gitignored). Never commit real passwords.
E2E_ADMIN_BASE_URL=http://127.0.0.1:4322
E2E_USER_BASE_URL=http://127.0.0.1:4323
E2E_API_BASE_URL=http://127.0.0.1:4321

E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=

# Invited-user password (global-setup, paper-flow, tenant-api). Min 10 chars.
E2E_INVITED_USER_PASSWORD=playwright-invite-10

# E2E_USER_EMAIL / E2E_USER_PASSWORD are written by e2e/global-setup.ts into
# e2e/.env.user.local (gitignored). Synthetic users only — not production accounts.
