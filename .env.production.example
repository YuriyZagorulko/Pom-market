# Production template for docker-compose.prod.yml (Coolify / VPS).
# Copy to .env on the server — never commit .env.
# Generate values: ./scripts/generate-secrets.sh
#
# Safety: CONFIRM_LIVE_TRADING must stay false until you deliberately enable live orders.

ENVIRONMENT=production
LOG_FORMAT=json
RUST_LOG=info,sqlx=warn
CONFIRM_LIVE_TRADING=false
PAPER_ALLOW_SYNTHETIC_FILLS=false

# --- PostgreSQL (compose service name: postgres; not exposed publicly) ---
POSTGRES_PASSWORD=CHANGE_ME_generate_with_scripts_generate_secrets_sh
APP_DB_PASSWORD=CHANGE_ME_app
WORKER_DB_PASSWORD=CHANGE_ME_worker
MIGRATION_DATABASE_URL=postgres://pommarket:CHANGE_ME_generate_with_scripts_generate_secrets_sh@postgres:5432/pommarket
APP_DATABASE_URL=postgres://pommarket_app:CHANGE_ME_app@postgres:5432/pommarket
WORKER_DATABASE_URL=postgres://pommarket_worker:CHANGE_ME_worker@postgres:5432/pommarket

# --- API (internal DNS: api:4321) ---
API_BIND=0.0.0.0:4321
TRUSTED_PROXIES=

# Public API host (Coolify domain on api:4321; included in API CORS when set)
PUBLIC_API_ORIGIN=https://pommarket-api.pomvix.com

# --- Public URLs (must match Coolify HTTPS; single-level hosts, wildcard TLS *.pomvix.com) ---
USER_ORIGIN=https://pommarket.pomvix.com
APP_BASE_URL=https://pommarket.pomvix.com
ADMIN_ORIGIN=https://pommarket-admin.pomvix.com
API_INTERNAL_URL=http://api:4321
# Extra browser origins only; USER_ORIGIN, ADMIN_ORIGIN, and PUBLIC_API_ORIGIN are added automatically
CORS_ORIGINS=

# --- Auth & encryption (required; min length enforced when ENVIRONMENT=production) ---
JWT_SECRET=CHANGE_ME_jwt_64_hex_or_more
ENCRYPTION_MASTER_KEY=CHANGE_ME_encryption_32_bytes
ENCRYPTION_KEY_ID=k1

# One-time bootstrap admin (change password after first login)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_admin_once
BOOTSTRAP_ADMIN_NAME=Administrator

# --- Email (Brevo) ---
BREVO_API_KEY=CHANGE_ME_brevo
BREVO_SENDER_EMAIL=noreply@example.com
BREVO_SENDER_NAME="POM Market"

# --- Polymarket (read-only defaults; no wallet keys here) ---
POLYMARKET_CLOB_HOST=https://clob.polymarket.com
POLYMARKET_DATA_API_HOST=https://data-api.polymarket.com
POLYMARKET_GAMMA_HOST=https://gamma-api.polymarket.com
POLYMARKET_RTDS_URL=wss://ws-live-data.polymarket.com
POLYGON_LOGS_ENABLED=false

WORKER_POLL_SECONDS=8
RECONCILIATION_SECONDS=30