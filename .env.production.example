# Production template. Copy to .env on the server. No dev passwords.
# Generate values: ./scripts/generate-secrets.sh

ENVIRONMENT=production
LOG_FORMAT=json
RUST_LOG=info,sqlx=warn
CONFIRM_LIVE_TRADING=false

# Internal compose DNS names — not localhost.
MIGRATION_DATABASE_URL=postgres://pommarket:CHANGE_ME_postgres@postgres:5432/pommarket
APP_DATABASE_URL=postgres://pommarket_app:CHANGE_ME_app@postgres:5432/pommarket
WORKER_DATABASE_URL=postgres://pommarket_worker:CHANGE_ME_worker@postgres:5432/pommarket
POSTGRES_PASSWORD=CHANGE_ME_postgres
APP_DB_PASSWORD=CHANGE_ME_app
WORKER_DB_PASSWORD=CHANGE_ME_worker

API_BIND=0.0.0.0:4321
# Edge proxy and/or internal Next.js subnets that forward client X-Forwarded-For (never use *).
TRUSTED_PROXIES=
API_PORT=4321
ADMIN_PORT=4322
USER_PORT=4323
ADMIN_ORIGIN=https://admin.example.com
USER_ORIGIN=https://app.example.com
APP_BASE_URL=https://app.example.com
API_INTERNAL_URL=http://api:4321
CORS_ORIGINS=

JWT_SECRET=CHANGE_ME_jwt_64_hex_or_more
ENCRYPTION_MASTER_KEY=CHANGE_ME_encryption_32_bytes
ENCRYPTION_KEY_ID=k1

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_admin_once
BOOTSTRAP_ADMIN_NAME=Administrator

BREVO_API_KEY=CHANGE_ME_brevo
BREVO_SENDER_EMAIL=noreply@example.com
BREVO_SENDER_NAME=POM Market

POLYMARKET_CLOB_HOST=https://clob.polymarket.com
POLYMARKET_DATA_API_HOST=https://data-api.polymarket.com
POLYMARKET_GAMMA_HOST=https://gamma-api.polymarket.com
POLYMARKET_RTDS_URL=wss://ws-live-data.polymarket.com
POLYGON_LOGS_ENABLED=false

WORKER_POLL_SECONDS=8
RECONCILIATION_SECONDS=30
