# =============================================================================
# Pom-Market Multi-Tenant Polymarket Copy-Trading Platform — .env.example
# =============================================================================
# NEVER commit real private keys, master encryption keys, or API secrets to git.

ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Dedicated Non-Default Development Host Ports
# (Internal container-to-container ports remain standard: 3000, 8000, 8080,
#  5432, 6379, 4222, 8222, 9090, 3000)
# -----------------------------------------------------------------------------
FRONTEND_PORT=4319
BACKEND_PORT=4320
RUST_ENGINE_PORT=4321
POSTGRES_PORT=5440
REDIS_PORT=6390
NATS_PORT=4225
NATS_MONITOR_PORT=8225
PROMETHEUS_PORT=9095
GRAFANA_PORT=3015

# PostgreSQL 16 connection string (host access on port 5440)
POSTGRES_PASSWORD=pommarket_dev_pass
DATABASE_URL=postgresql+psycopg2://pommarket:pommarket_dev_pass@localhost:5440/pommarket

# Redis & NATS JetStream (host access on ports 6390 and 4225)
REDIS_URL=redis://localhost:6390/0
NATS_URL=nats://localhost:4225
NATS_MONITOR_URL=http://localhost:8225

# Allowed CORS Origins for local development
CORS_ALLOWED_ORIGINS=http://localhost:4319,http://127.0.0.1:4319

# JWT signing secret (generate via `openssl rand -hex 32`)
JWT_SECRET_KEY=replace-with-64-hex-char-random-jwt-signing-key-in-production

# External Master Encryption Key for AES-256-GCM credential vault
# Kept strictly outside the database. Generate via `openssl rand -base64 32`.
MASTER_ENCRYPTION_KEY=replace-with-external-32-byte-master-encryption-key-seed
MASTER_ENCRYPTION_KEY_PREVIOUS=

# Official Polymarket Endpoints
POLYMARKET_CLOB_HOST=https://clob.polymarket.com
POLYMARKET_GAMMA_HOST=https://gamma-api.polymarket.com
POLYMARKET_DATA_API_HOST=https://data-api.polymarket.com
POLYMARKET_RTDS_WS_URL=wss://ws-live-data.polymarket.com

# Polygon Mainnet CTF Exchange V2 Contracts
POLYGON_CHAIN_ID=137
POLYGON_CTF_EXCHANGE_V2_ADDRESS=0xE111180000d2663C0091e4f400237545B87B996B
POLYGON_NEG_RISK_CTF_EXCHANGE_V2_ADDRESS=0xe2222d279d744050d28e00520010520000310F59

# Platform Safety & Rate Limiting Defaults
DEFAULT_OPERATING_MODE=MONITORING
GLOBAL_RATE_LIMIT_RPS=15.0
PER_ACCOUNT_RATE_LIMIT_RPM=30
STALE_DATA_THRESHOLD_SECONDS=60
EMAIL_DELIVERY_ENABLED=false

# Next.js Frontend Browser-Side URLs (must use externally accessible host port 4320)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4320
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:4320
