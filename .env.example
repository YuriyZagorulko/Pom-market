# Pom-Market environment. Copy to .env and replace CHANGE_ME values.
# Generate secrets with: ./scripts/generate-secrets.sh
#
# Required before the API will start:
#   MIGRATION_DATABASE_URL, APP_DATABASE_URL, WORKER_DATABASE_URL
#   JWT_SECRET, ENCRYPTION_MASTER_KEY
#   BOOTSTRAP_ADMIN_EMAIL and BOOTSTRAP_ADMIN_PASSWORD on the first boot
#
# Safe defaults exist for Polymarket hosts, ports, and polling.
# CONFIRM_LIVE_TRADING must stay false until you intentionally enable real orders.

ENVIRONMENT=development
LOG_FORMAT=json
RUST_LOG=info,sqlx=warn

# Host ports. Container-internal Postgres stays on 5432.
API_PORT=4321
ADMIN_PORT=4322
USER_PORT=4323
# Playwright E2E stack (docker profile e2e) — DB pommarket_e2e
E2E_API_PORT=4324
E2E_ADMIN_PORT=4325
E2E_USER_PORT=4326
POSTGRES_PORT=5440
API_BIND=0.0.0.0:4321
# Comma-separated CIDRs/IPs of reverse proxies that may set X-Forwarded-For (empty = peer IP only).
TRUSTED_PROXIES=

# Superuser URL is used only to migrate and to create the first administrator.
POSTGRES_PASSWORD=CHANGE_ME_postgres
MIGRATION_DATABASE_URL=postgres://pommarket:CHANGE_ME_postgres@localhost:5440/pommarket
# Application roles are NOSUPERUSER and NOBYPASSRLS. The API sets their passwords on startup.
APP_DB_PASSWORD=CHANGE_ME_app
WORKER_DB_PASSWORD=CHANGE_ME_worker
APP_DATABASE_URL=postgres://pommarket_app:CHANGE_ME_app@localhost:5440/pommarket
WORKER_DATABASE_URL=postgres://pommarket_worker:CHANGE_ME_worker@localhost:5440/pommarket

ADMIN_ORIGIN=http://localhost:4322
USER_ORIGIN=http://localhost:4323
CORS_ORIGINS=

# openssl rand -hex 32
JWT_SECRET=CHANGE_ME_jwt
ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=1209600
INVITE_TTL_HOURS=72
PASSWORD_RESET_TTL_MINUTES=30

# openssl rand -base64 32
# Rotation: set ENCRYPTION_MASTER_KEY to the new key, move the old key to
# ENCRYPTION_MASTER_KEY_PREVIOUS, then run `pom-api --rotate-keys`.
ENCRYPTION_MASTER_KEY=CHANGE_ME_encryption
ENCRYPTION_KEY_ID=k1
ENCRYPTION_MASTER_KEY_PREVIOUS=
ENCRYPTION_KEY_ID_PREVIOUS=

# First administrator. Used once, only when no admin exists. Shown invitation
# links are returned to the admin UI and are not trading secrets.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_admin_password
BOOTSTRAP_ADMIN_NAME=Administrator

# Official Polymarket endpoints as of the CLOB V2 client.
# clob.polymarket.com currently serves CLOB version 2. clob-v2.polymarket.com has no public DNS record.
POLYMARKET_CLOB_HOST=https://clob.polymarket.com
POLYMARKET_DATA_API_HOST=https://data-api.polymarket.com
POLYMARKET_GAMMA_HOST=https://gamma-api.polymarket.com
POLYMARKET_RTDS_URL=wss://ws-live-data.polymarket.com

# Polygon is optional. Leave POLYGON_LOGS_ENABLED false until the RPC is yours.
POLYGON_CHAIN_ID=137
POLYGON_RPC_URL=
POLYGON_LOGS_ENABLED=false
POLYGON_CTF_EXCHANGE_ADDRESS=0xE111180000d2663C0091e4f400237545B87B996B
POLYGON_NEG_RISK_EXCHANGE_ADDRESS=0xe2222d279d744050d28e00520010520000310F59

WORKER_POLL_SECONDS=8
RECONCILIATION_SECONDS=30
# Must be false unless you intend to send real orders. Tests never set this.
CONFIRM_LIVE_TRADING=false
# Used only when the market fee endpoint does not return a schedule.
# 0 means the fee is recorded as unknown rather than invented.
TAKER_FEE_RATE=0
TAKER_FEE_EXPONENT=1

# Frontend build/runtime. Browsers call the Next.js origin; Next proxies /api to Rust.
API_INTERNAL_URL=http://127.0.0.1:4321
APP_BASE_URL=http://localhost:4323

# Transactional email (Brevo). BREEVO_API_KEY is accepted as a legacy alias.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@example.com
BREVO_SENDER_NAME="POM Market"
# Optional override for tests or self-hosted mocks.
BREVO_API_BASE=
