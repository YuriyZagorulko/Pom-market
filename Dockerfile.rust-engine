FROM rust:1.99-slim AS builder

WORKDIR /usr/src/pommarket-engine
RUN apt-get update && apt-get install -y --no-install-recommends pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*

COPY rust-engine/Cargo.toml ./Cargo.toml
COPY rust-engine/src ./src
RUN cargo build --release

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/*
COPY --from=builder /usr/src/pommarket-engine/target/release/pommarket-engine /usr/local/bin/pommarket-engine

ENV RUST_ENGINE_BIND_ADDR=0.0.0.0:8080
EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=5s --retries=3 \
  CMD curl -f http://localhost:8080/health || exit 1

CMD ["/usr/local/bin/pommarket-engine"]
