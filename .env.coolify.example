# Legacy Coolify compose (docker-compose.coolify.yml, market.pomvix.com staging).
# Production PomMarket: use .env.production.example (pommarket.pomvix.com, pommarket-admin.pomvix.com, pommarket-api.pomvix.com).
# Copy to .env on the server — never commit .env.
# Generate secrets: ./scripts/generate-secrets.sh
#
# Safety: CONFIRM_LIVE_TRADING must stay false. No real wallet keys in this file.

# staging = normal validation; production enables extra secret-strength checks in Config::validate()
ENVIRONMENT=staging
LOG_FORMAT=json
RUST_LOG=info,sqlx=warn
CONFIRM_LIVE_TRADING=false
PAPER_ALLOW_SYNTHETIC_FILLS=false

# --- Database (compose service name: postgres) ---
POSTGRES_PASSWORD=CHANGE_ME_generate_with_scripts_generate_secrets_sh
APP_DB_PASSWORD=CHANGE_ME_app
WORKER_DB_PASSWORD=CHANGE_ME_worker
MIGRATION_DATABASE_URL=postgres://pommarket:CHANGE_ME_generate_with_scripts_generate_secrets_sh@postgres:5432/pommarket
APP_DATABASE_URL=postgres://pommarket_app:CHANGE_ME_app@postgres:5432/pommarket
WORKER_DATABASE_URL=postgres://pommarket_worker:CHANGE_ME_worker@postgres:5432/pommarket

# --- API (internal; not published in docker-compose.coolify.yml) ---
API_BIND=0.0.0.0:4321
TRUSTED_PROXIES=
# Coolify terminates TLS; browser uses same-origin /api via Next.js — leave empty unless API is directly behind your edge.

# --- Public user app (Coolify domain) ---
USER_ORIGIN=https://market.pomvix.com
APP_BASE_URL=https://market.pomvix.com
USER_PORT=4323
# Admin UI optional (profile admin); set if you enable it behind a separate domain.
ADMIN_ORIGIN=https://admin.market.pomvix.com
API_INTERNAL_URL=http://api:4321
CORS_ORIGINS=

# --- Auth & encryption (use strong unique values; required length if ENVIRONMENT=production) ---
JWT_SECRET=CHANGE_ME_jwt_64_hex_or_more
ENCRYPTION_MASTER_KEY=CHANGE_ME_encryption_32_bytes
ENCRYPTION_KEY_ID=k1

# One-time bootstrap admin (change password after first login; omit after bootstrap if desired)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_admin_once
BOOTSTRAP_ADMIN_NAME=Administrator

# --- Email (Brevo) ---
BREVO_API_KEY=CHANGE_ME_brevo
BREVO_SENDER_EMAIL=noreply@example.com
BREVO_SENDER_NAME="POM Market"

# --- Polymarket read-only defaults (no live CLOB submission without live trading gate) ---
POLYMARKET_CLOB_HOST=https://clob.polymarket.com
POLYMARKET_DATA_API_HOST=https://data-api.polymarket.com
POLYMARKET_GAMMA_HOST=https://gamma-api.polymarket.com
POLYMARKET_RTDS_URL=wss://ws-live-data.polymarket.com
POLYGON_LOGS_ENABLED=false

WORKER_POLL_SECONDS=8
RECONCILIATION_SECONDS=30